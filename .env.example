# red_lite_cache configuration. Copy to .env; every value is also an environment variable.
# Read once by internal/config. Nothing else reads the environment.

# Server
REDLITE_PORT=:8081
REDLITE_ENVIRONMENT=development          # development | staging | production
REDLITE_ROLE=leader                      # leader | replica
REDLITE_LEADER_ADDRESS=                  # replica only: ws://leader-host:8081/ws
REDLITE_LOG_LEVEL=info                   # debug | info | warn | error

# Cache
REDLITE_CACHE_TTL=15m
REDLITE_CACHE_JITTER_PERCENT=20
REDLITE_CACHE_JANITOR_INTERVAL=60s
REDLITE_CACHE_MAX_KEYS_PER_SHEET=0       # 0 = unbounded (say so in a comment where it is read)

# Locks
REDLITE_LOCK_TTL=30s
REDLITE_LOCK_CLEANUP_INTERVAL=5s

# Replication
REDLITE_HEARTBEAT_INTERVAL=5s
REDLITE_HEARTBEAT_TIMEOUT=10s

# Persistence (S5) — off until the database exists
REDLITE_PERSIST_ENABLED=false
REDLITE_PERSIST_DATABASE_URL=
REDLITE_PERSIST_BATCH_SIZE=100
REDLITE_PERSIST_FLUSH_INTERVAL=5s
REDLITE_PERSIST_CLEANUP_INTERVAL=60s
REDLITE_PERSIST_POOL_MAX=5
REDLITE_PERSIST_POOL_MIN=1

# Management API (S6)
REDLITE_ADMIN_KEY=

# Tests only — never set in production
# REDLITE_TEST_DATABASE_URL=postgres://user:pass@localhost:5432/redlite_test
