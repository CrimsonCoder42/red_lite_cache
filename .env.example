# PROPOSED replacement for /.env.example — the agent could not write .env.example (Read-deny rule on .env.*).
# Devin: `cp doc/bootstrap_2026-10-29/env.example.proposed .env.example`. Every variable matches internal/config/config.go.
#
# red_lite_cache configuration. Copy to .env; every value is also an environment variable.
# Read once by internal/config. Nothing else reads the environment.
# Default ports are :8091 (leader) / :8092 (replica) so a local advo_cache on :8081/:8082 is untouched.

# Server
REDLITE_PORT=:8091
REDLITE_ENVIRONMENT=development          # development | staging | production (production = JSON logs)
REDLITE_ROLE=leader                      # leader | replica
REDLITE_LEADER_ADDRESS=                  # replica only: ws://leader-host:8091/replica
REDLITE_PEER_ADDRESS=                    # the other node, ws://host:port — a leader probes it and steps down to a higher epoch (D-012)
REDLITE_INSTANCE_ID=                     # empty = generated at boot
REDLITE_LOG_LEVEL=info                   # debug | info | warn | error
REDLITE_SHUTDOWN_TIMEOUT=10s

# Cache
REDLITE_CACHE_TTL=15m                    # default for a set with ttl 0/absent; 0 = no expiry
REDLITE_CACHE_JITTER_PERCENT=20          # every TTL gets 0..N% added (server policy; the v1 `jitter` flag is ignored)
REDLITE_CACHE_JANITOR_INTERVAL=60s       # one janitor per process sweeps expired keys and broadcasts them
REDLITE_CACHE_MAX_KEYS_PER_SHEET=0       # 0 = unbounded; a set of a new key on a full sheet answers "sheet full"

# Sheets (D-013)
REDLITE_SHEET_AUTOCREATE=true            # true = the first open creates the sheet (v1); false = only the admin API creates sheets
REDLITE_BCRYPT_COST=10
REDLITE_SWEEP_LOG_WINDOW=30s             # R6: an invalidation is remembered this long to refuse a stale read-through set
REDLITE_SWEEP_LOG_MAX=4096               # R6: at most this many remembered per sheet

# Connections (D-014, K15)
REDLITE_CONN_SEND_QUEUE=256              # frames queued per client; a full queue closes that connection (it resyncs)
REDLITE_REPLICA_SEND_QUEUE=4096
REDLITE_MAX_FRAME_BYTES=1048576          # read limit on a client frame
REDLITE_REPLICA_MAX_FRAME_BYTES=67108864 # read limit on a replica frame (snapshot_sheet)
REDLITE_PING_INTERVAL=15s
REDLITE_WRITE_TIMEOUT=10s

# Locks
REDLITE_LOCK_TTL=30s
REDLITE_LOCK_CLEANUP_INTERVAL=5s

# Replication
REDLITE_HEARTBEAT_INTERVAL=5s
REDLITE_HEARTBEAT_TIMEOUT=10s            # a replica promotes after this long without a heartbeat

# Persistence (S5) — off until the database exists
REDLITE_PERSIST_ENABLED=false
REDLITE_PERSIST_DATABASE_URL=            # postgres://user:pass@host:5432/redlite?sslmode=disable
REDLITE_PERSIST_BATCH_SIZE=100
REDLITE_PERSIST_FLUSH_INTERVAL=5s
REDLITE_PERSIST_CLEANUP_INTERVAL=60s
REDLITE_PERSIST_POOL_MAX=5
REDLITE_PERSIST_POOL_MIN=1
REDLITE_PERSIST_QUEUE_SIZE=10000         # write-behind channel; full = op dropped with a Warn, never blocks
REDLITE_PERSIST_LOGGED=false             # D-020: true = cache_entries made LOGGED at boot (survives a Postgres crash/failover)
REDLITE_CONTROL_LISTEN=true              # D-021: LISTEN redlite_control for registry changes (persistence on only)
REDLITE_ELECTION=epoch                   # D-022: epoch | advisory (pg_try_advisory_lock decides the leader; needs persistence)

# Management API (S6) — /admin/* answers 401 while this is empty
REDLITE_ADMIN_KEY=

# Tests only — never set in production
# REDLITE_TEST_DATABASE_URL=postgres://user:pass@localhost:5432/redlite_test?sslmode=disable
